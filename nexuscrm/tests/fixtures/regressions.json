{
  "_readme": "PERMANENT REGRESSION CORPUS (Phase 1.4). Every bug found in a real cycle becomes a fixture here, forever. Fixtures are DATA, not code, so adding one never means editing a suite. Three classes: 'bad' MUST be caught, 'good' MUST NOT be flagged, 'edge' must not crash. Each entry records the cycle it came from and what actually broke.",
  "bad": [
    {
      "id": "unclosed-container",
      "cycle": 4,
      "found": "AST validation",
      "bug": "an unclosed <div> silently changed the rendered layout; the browser repaired it its own way",
      "expect": "html-validity",
      "html": "<!DOCTYPE html><html lang=\"en\"><head><title>t</title><meta name=\"description\" content=\"d\"></head><body><main><div><p>x</p></main></body></html>"
    },
    {
      "id": "flow-inside-paragraph",
      "cycle": 4,
      "found": "AST validation",
      "bug": "a <div> inside a <p> makes the browser close the paragraph early, changing layout",
      "expect": "html-validity",
      "html": "<!DOCTYPE html><html lang=\"en\"><head><title>t</title><meta name=\"description\" content=\"d\"></head><body><main><p><div>x</div></p></main></body></html>"
    },
