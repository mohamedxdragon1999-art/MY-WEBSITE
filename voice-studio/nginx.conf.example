# Example nginx reverse proxy for Voice Studio (TLS + SSE-friendly).
#
# Key points for this app:
#   - proxy_buffering off on the streaming endpoint so SSE tokens arrive live.
#   - long read timeout so streamed replies aren't cut off.
#   - pass the real client IP so per-client rate limiting is accurate.
#   - optional nginx-level rate limiting as a first line of defense.
#
# Replace voice.example.com and the cert paths with your own.

limit_req_zone $binary_remote_addr zone=voice_api:10m rate=10r/s;

upstream voice_studio {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name voice.example.com;
    # Redirect all HTTP to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name voice.example.com;

    ssl_certificate     /etc/letsencrypt/live/voice.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voice.example.com/privkey.pem;

    # Reasonable upload size for POSTed text.
    client_max_body_size 1m;

    # ---- Streaming endpoint: disable buffering so SSE flushes immediately ----
    location /api/reply-stream {
        limit_req zone=voice_api burst=20 nodelay;
        proxy_pass http://voice_studio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # ---- Everything else ----
    location / {
        limit_req zone=voice_api burst=40 nodelay;
        proxy_pass http://voice_studio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
