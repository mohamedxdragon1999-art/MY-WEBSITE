# ---------------------------------------------------------------------------
# Voice Studio - optional settings. Copy this file to ".env" and fill in keys.
# Everything here is OPTIONAL. With no keys the site still works (offline brain
# + the voice modes). Add any ONE free AI key below to make the agent much
# smarter; the brain uses the first that works and falls back automatically.
# ---------------------------------------------------------------------------

# ===== Free cloud AI providers (pick one or more; all have a free tier) =====
# Groq - very fast, generous free tier         https://console.groq.com
GROQ_API_KEY=
# Cerebras - very fast, free                    https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# NVIDIA NIM - free                             https://build.nvidia.com
NVIDIA_API_KEY=
# Google Gemini - free tier                     https://aistudio.google.com
GEMINI_API_KEY=
# Mistral - free tier                           https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter - many free models                 https://openrouter.ai
OPENROUTER_API_KEY=
# Together AI - free models                     https://api.together.ai
TOGETHER_API_KEY=

# Priority order (optional). Comma-separated ids from:
#   groq,cerebras,nvidia,gemini,mistral,openrouter,together
# BRAIN_ORDER=groq,nvidia

# Override a provider's model (optional), e.g.:
# GROQ_MODEL=llama-3.1-8b-instant

# Force the offline responder even if keys are set (optional):
# BRAIN_DISABLE=1

# Reply style tuning (optional):
# BRAIN_TEMPERATURE=0.6   # 0.0 = focused, 1.0+ = more varied/creative
# BRAIN_MAX_TOKENS=320    # max length of each spoken reply

# ===== NVIDIA Magpie voice (Mode 4) - separate from the brain above =====
# NVIDIA_API_KEY above is reused for Magpie TTS too.
# MAGPIE_URL=https://integrate.api.nvidia.com/v1/audio/speech
# MAGPIE_VOICE=Magpie-Multilingual.EN-US.Sofia
# MAGPIE_MODEL=magpie-tts-multilingual

# ===== Performance (optional) =====
# Max concurrent CPU voice synths (Kokoro/Piper). Default = CPU cores, capped 4.
# VOICE_CPU_CONCURRENCY=4
# Max concurrent network synths (edge/magpie). Default 32.
# VOICE_NET_CONCURRENCY=32
# Speech-to-text model size if using server STT (tiny/base/small).
# WHISPER_MODEL=base

# ===========================================================================
# ENTERPRISE / MULTI-TENANT (optional) - see ENTERPRISE.md for the full guide
# ===========================================================================

# Path to your tenant registry (one server -> many websites). If unset, the app
# looks for ./tenants.json, and if that's missing it runs as a single site that
# allows every origin (fine for one site / local dev).
# VOICE_TENANTS_FILE=/app/tenants.json

# Server-side conversation memory: how long an idle session is kept (seconds).
# SESSION_TTL_SEC=1800

# Backpressure: max concurrent heavy operations (AI + synth) in flight PER
# worker. Extra requests wait briefly instead of overwhelming the box. With
# several gunicorn workers, effective capacity = workers x this number.
# VOICE_MAX_INFLIGHT=96

# Security: reject JSON request bodies larger than this many bytes (memory-abuse
# protection). STT audio uploads are exempt. Default 262144 (256 KB).
# VOICE_MAX_BODY_BYTES=262144

# Security: how many proxy hops (X-Forwarded-For entries) to trust for the
# client IP used by rate limiting. Default 1 matches the bundled nginx. Set to 0
# when the app is DIRECTLY exposed to the internet, otherwise clients can spoof
# X-Forwarded-For to dodge the rate limiter.
# VOICE_TRUSTED_PROXY_HOPS=1

# Log level for the structured JSON access log (DEBUG/INFO/WARNING/ERROR).
# LOG_LEVEL=INFO

# Log files: the app writes rotating JSON logs so voice problems are captured on
# disk. voice-studio.log = every event; voice-errors.log = problems only
# (fallbacks, synth failures, engine-unavailable). Defaults to ./logs.
# VOICE_LOG_DIR=/var/log/voice-studio
# VOICE_LOG_MAX_BYTES=5000000    # rotate each file at this size (bytes)
# VOICE_LOG_BACKUPS=5            # how many rotated files to keep

# Reliability: max seconds to wait for ONE voice synthesis before giving up on
# that engine and automatically trying the next one in the fallback chain.
# VOICE_SYNTH_TIMEOUT=30

# Gunicorn (production process manager) - see gunicorn_conf.py:
# WEB_CONCURRENCY=4        # number of worker processes (default 2*cores+1, max 8)
# GUNICORN_TIMEOUT=120     # keep high so streamed (SSE) replies aren't cut off

# Per-tenant AI keys: name the env var in each tenant's "brain_key_env" and set
# it here. The key itself NEVER lives in tenants.json. Example:
# ACME_AI_KEY=nvapi-...
# GLOBEX_AI_KEY=gsk_...

# ============================================================================
# v16 SPEED + FREE CAPACITY
# ============================================================================
# Free AI tiers are rate limited PER KEY, not per person. One key is the single
# biggest reason a busy site starts returning errors. The fix is free: create
# several free keys and let the server rotate across them. 5 free NVIDIA keys
# is roughly 180 requests/minute (~45 callers talking at once) and still costs
# nothing. If a key hits its limit it is benched for a few seconds and the next
# key takes over, so the caller never sees an error.
#
# Three accepted spellings (mix freely, duplicates are ignored):
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
# ...up to NVIDIA_API_KEY_25
NVIDIA_API_KEYS=
# ^ comma separated, e.g. nvapi-aaa,nvapi-bbb,nvapi-ccc
#
# The same three spellings work for every provider:
#   GROQ_API_KEY / GROQ_API_KEY_2 / GROQ_API_KEYS
#   CEREBRAS_API_KEY / GEMINI_API_KEY / MISTRAL_API_KEY / OPENROUTER_API_KEY
#   TOGETHER_API_KEY / GITHUB_API_KEY

# --- Cloudflare Workers AI: another genuinely free provider (no card) ---
# 10,000 free Neurons/day. Needs BOTH values or it is skipped automatically.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- Per-provider rate limits (only override if your tier differs) ---
# Defaults per key: nvidia 36/min, groq 28/min, cerebras 28/min,
# cloudflare 60/min, gemini 14/min, mistral 55/min, openrouter 18/min,
# together 55/min, github 14/min.
# NVIDIA_RPM=36
# NVIDIA_RPD=40000

# --- Connection prewarming (this is what removes the slow first reply) ---
# A cold DNS + TLS handshake can add up to ~2 seconds. The server opens and
# holds a warm HTTP/2 connection to every provider at startup, then re-pings
# it so it never goes cold on a quiet site.
BRAIN_PREWARM=1
BRAIN_KEEPALIVE_SEC=240

# --- Provider order: first one with a key wins, rest are automatic fallback ---
# BRAIN_ORDER=groq,cerebras,nvidia,cloudflare,gemini,mistral,openrouter,together

# ===========================================================================
# v5 - ULTRA HUMAN MODE (the new flagship voice)
# ===========================================================================
# Tier 1: Fish Audio S2.1 Pro - FREE cloud, no credit card, unlimited under
# fair use. Highest-ranked open-weights voice on the blind Speech Arena.
# Get a key at https://fish.audio  ->  paste it here. This is the single
# biggest realism upgrade in the whole app, and it costs nothing.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# FISH_URL=https://api.fish.audio/v1/tts
# FISH_VOICE=default
# FISH_TIMEOUT=20

# Tier 2: Chatterbox - local, MIT licensed, no network, no key.
# nano = 110M params, ~3x faster than real time on 8 CPU cores (recommended)
# turbo = 350M params, higher quality, wants a GPU to feel instant
# CHATTERBOX_MODEL=nano
# CHATTERBOX_DEVICE=cpu
# CHATTERBOX_EXAG=0.5
# CHATTERBOX_REF=/path/to/5-second-reference-clip.wav

# Ultra Human orchestration
# HUMAN_ORDER=fish,chatterbox,kokoro,edge,piper
# HUMAN_EXPRESSIVENESS=0.5     # 0 = flat and formal, 1 = very animated
# HUMAN_COOLDOWN_SEC=20        # how long a failed tier is skipped

# --- v5.1 hardening -------------------------------------------------------
# Fish is a FREE tier with no SLA and its requests MAY BE RETAINED by Fish for
# model improvement. If your callers say order numbers, addresses or card
# details, set this to 1 - it hard-disables the cloud tier and keeps everything
# local. This is the safe choice for real customer service.
# FISH_PRIVACY_STRICT=0
# FISH_TIMEOUT=12     # fail fast to the local voice instead of leaving silence
# FISH_RETRIES=1
# FISH_MAX_RPM=120    # local fair-use guard so the free key never gets banned

# Chatterbox RAM guard: refuses to load a variant bigger than the box can hold.
# nano ~2.5GB | turbo ~5GB | full ~9GB (the full model is a GPU model - avoid)
# CHATTERBOX_THREADS=8   # cap threads so concurrent callers queue instead of thrash

# --- v5.2: universal humanization (applies to EVERY mode) -----------------
# Written English is not spoken English. Every engine now rewrites text into
# speech before synthesis: contractions, natural pacing, breath points. This is
# the single biggest reason a voice stops sounding like a document reader.
# VOICE_HUMANIZE=1        # 0 = read text verbatim (use for legal/scripted copy)
# VOICE_EXPRESSIVENESS=0.5  # 0.0 flat and literal ... 1.0 very expressive

# ---------------------------------------------------------------------------
# v6.0 - CALL MODE + TURBO CAPTURE (the "words taker")
# ---------------------------------------------------------------------------
# The browser's own speech recognition is slow and drops words. With an NVIDIA
# key the site instead records each turn and transcribes it with a
# Parakeet-class model (RTFx ~3386 vs ~100 for Whisper-class decoding), which
# is the 10-30x class of speedup. It falls back to the browser automatically,
# so nothing breaks if you leave this unset.

# Reuses NVIDIA_API_KEY above if you do not set a dedicated one.
# NVIDIA_ASR_API_KEY=nvapi-...

# Turn fast capture off and always use the browser recognizer.
VOICE_FAST_STT=1

# Default model. Alternatives: nvidia/parakeet-ctc-0.6b-asr,
# nvidia/canary-1b-flash, openai/whisper-large-v3 (slowest).
NVIDIA_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v2

# Endpoint. Change this if you run your own ASR NIM container, e.g.
#   NVIDIA_ASR_URL=http://localhost:9000/v1/transcribe
NVIDIA_ASR_URL=https://integrate.api.nvidia.com/v1/audio/transcriptions

# Seconds to wait for a transcript before falling back (clamped 2-60).
NVIDIA_ASR_TIMEOUT=12

# ---------------------------------------------------------------------------
# v6.1 EMOTION
# ---------------------------------------------------------------------------
# Master switch. 0 gives a deliberately flat, corporate voice.
VOICE_EMOTION=1

# 0 = neutral, 1 = full performance. Controls how far rate/pitch/volume move
# from neutral. Pitch is capped under 4 semitones at every setting so it never
# tips over into sounding like a cartoon.
VOICE_EMOTION_INTENSITY=0.75

# ---------------------------------------------------------------------------
# v6.2 - keyword boosting (word capture)
# ---------------------------------------------------------------------------
# Comma-separated words the recogniser should be biased toward: product names,
# people, reference codes - anything it keeps getting wrong. Boosting raises the
# probability of these exact tokens at decode time without retraining and
# without affecting ordinary words. It is the cheapest accuracy win available.
# 10-40 terms is the sweet spot; past that the bias starts hurting normal words,
# so the list is capped at 40 automatically.
# Callers can also set their own list in Settings, which is merged with this one.
VOICE_ASR_HOTWORDS=

# ---------------------------------------------------------------------------
# v6.3 - acoustic prosody (VOICE_FX)
# ---------------------------------------------------------------------------
# Real DSP applied to the generated waveform: terminal rise/fall, declination,
# word-level emphasis, and the micro-instability (jitter/shimmer) that stops a
# voice sounding mechanical. Kokoro and Piper expose no pitch control at all,
# so before this the intonation was faked with speaking rate. Now the audio
# itself is reshaped.
# Set to 0 to ship the raw engine audio instead.
VOICE_FX=1

# How far the prosody is pushed. 0 = bypass, 1 = full performance.
# Above ~1.2 the pitch movement starts to sound theatrical; below ~0.5 it is
# barely audible. 1.0 is the tuned default.
VOICE_FX_STRENGTH=1.0

# How long an inhale to put in front of a heavy reply, in ms (0 disables).
# Only used at the START of a turn and only for heavy emotions - a breath
# between every clause sounds asthmatic, not human.
VOICE_BREATH_MS=150

# ---------------------------------------------------------------------------
# v49 - realtime full-duplex voice (/ws/voice)
# ---------------------------------------------------------------------------
# The HTTP routes (/api/stt, /api/reply-stream, /api/tts) are unchanged and
# still work. This is an ADDITIONAL streaming transport, not a migration, so
# you can roll it out and roll it back without touching the rest of the config.
#
# What changed and why it is faster:
#   * Audio streams as 20 ms raw PCM frames over a WebSocket instead of being
#     re-uploaded as a growing blob every 700 ms. Recognition cost per tick is
#     now constant instead of growing with the length of the sentence.
#   * End of turn is decided by fusing what was SAID with HOW it was said,
#     rather than by a fixed timer. "My account number is..." waits; "yes,
#     that's right." answers almost immediately.
#   * The reply is spoken clause by clause as the model generates it, so the
#     first audio starts long before the full answer exists.

# Ceiling for synthesising ONE sentence chunk mid-reply, across the whole
# engine fallback chain (seconds). Much tighter than VOICE_SYNTH_TOTAL because
# the caller is already listening: audio that arrives late is worse than
# useless, the conversation has moved on.
VOICE_RT_SYNTH_TOTAL=8.0

# Turn-taking sensitivity, also settable per connection via ?sensitivity=.
# Range 0.5 - 2.0. Higher = answers sooner (snappier, but more likely to cut
# people off). Lower = waits longer (more patient, feels less responsive).
# 1.0 is tuned; raise it for short transactional calls, lower it for callers
# who think out loud or read numbers aloud.
VOICE_RT_SENSITIVITY=1.0

# ---------------------------------------------------------------------------
# v0.0.51 - CPU-ONLY DEPLOYMENT
# ---------------------------------------------------------------------------
# This project ships eight engine ids, but only four can serve audio on a box
# with no GPU:
#
#   kokoro   local, offline, Apache-2.0, ~1.8x real time on 4 CPU cores  <- best
#   edge     Microsoft neural voices. Free, no key, but ONLINE.
#   piper    local, tiny, ~30x real time. Never the prettiest, never fails.
#   magpie   NVIDIA NIM. Cloud, needs a free key.
#
# fish and chatterbox need a local NVIDIA GPU. fish ALSO ships under the Fish
# Audio Research License, which is non-commercial.
#
# Until v0.0.51 the fallback ladders listed fish and chatterbox AHEAD of
# kokoro, so a CPU-only server tried two impossible engines - and paid a
# failure, sometimes a network timeout, for each - before reaching the engine
# that was always going to speak. That is now fixed.

# Master switch. 1 = assume no GPU (the default as of v51).
# Set to 0 ONLY if this machine has a real NVIDIA GPU.
VOICE_CPU_ONLY=1

# Allow engines whose WEIGHTS forbid commercial use (currently: fish).
# Leave at 0 for anything you charge money for. This is a licensing switch,
# not a technical one: turning it on does not give you a GPU.
VOICE_ALLOW_NONCOMMERCIAL=0

# Longest string handed to a CPU neural engine in one call (60-400).
# Kokoro's real-time factor gets WORSE on longer input rather than amortising
# down (measured 0.51 -> 0.69 from short to extended text), so synthesising in
# short pieces is free speed AND better time-to-first-audio. Lower = snappier
# first syllable; higher = slightly smoother joins.
VOICE_CPU_CHUNK_CHARS=180

# Threads for CPU inference. Blank = auto (all cores but one).
# ONNX Runtime otherwise grabs every core, so one synthesis makes the SECOND
# concurrent caller wait and starves the event loop. Leaving a core free is
# what keeps the server responsive under load.
# VOICE_CPU_THREADS=3

# Use int8-quantised Kokoro weights when present at
# models/kokoro/kokoro-v1.0.int8.onnx (~4x smaller, faster on CPU).
# Purely opt-in: if you never download that file this does nothing.
VOICE_KOKORO_INT8=1
