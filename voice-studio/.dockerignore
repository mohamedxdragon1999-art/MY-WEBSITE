# Keep the image small and free of secrets / local junk.
.git
.gitignore
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*
!.env.example
*.log
.DS_Store
node_modules/
tests/
*.zip
# Large local voice models are mounted at runtime, not baked into the image.
models/piper/*
models/kokoro/*
!models/**/.gitkeep
